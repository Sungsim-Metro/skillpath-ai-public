# 복사해서 .env 로 저장한 뒤 값을 채웁니다. .env 는 커밋하지 않습니다.
AWS_PROFILE=kosa
AWS_REGION=ap-northeast-2
BEDROCK_MOCK=1
# Bedrock 호출 기록 파일(토큰·비용 화면용). 비우면 outputs/usage/usage.jsonl. 내용은 남기지 않고 토큰 수만 남긴다
USAGE_LOG=
# 관리자 화면을 여는 값. 주소 /admin?admin=<이 값> 으로 연다. 비우면 열리지 않는다. 값은 .env 에만 적는다
ADMIN_KEY=
TEAM=
# 모델 ID는 코드에 적지 않고 여기서 바꿉니다(모델은 Legacy → 지원 종료로 바뀝니다). 값은 팀 계정에서 호출되는 ID로 채웁니다.
BEDROCK_MODEL_ID=
EMBED_MODEL_ID=
# 평가용 채점 모델(상담 답 LLM 채점, #94). 답을 쓰는 BEDROCK_MODEL_ID 와 다른 모델을 적는다(자기 글을 후하게 채점하지 않게). 서비스 실행 경로에서는 쓰지 않는다
JUDGE_MODEL_ID=
# 교육과정 검색용 Bedrock Knowledge Base (실제 모드)
BEDROCK_KB_ID=

# 로켓펀치 App Key (rp_app_...). 값은 .env 에만 적는다.
ROCKETPUNCH_API_KEY=
# Rocketpunch S3 storage (empty bucket means local-only storage)
ROCKETPUNCH_S3_BUCKET=
ROCKETPUNCH_S3_PREFIX=

# DynamoDB 테이블명. 둘 다 설정하면 fetch·collect 후 추출·수요 집계를 저장합니다.
# 테이블 생성 예시 이름은 skillpath-posting-extractions, skillpath-demand입니다.
DYNAMODB_EXTRACTIONS_TABLE=
DYNAMODB_DEMAND_TABLE=

# 닉네임 프로필 저장소
DYNAMODB_PROFILE_TABLE=
SKILLPATH_MOCK_PROFILE_DB=

# 입력 가드레일 (#24). 화면 상담(ai/chat.py)과 상담 에이전트(ai/agent.py)가 같은 ai/guardrail.py 로 검사한다.
# ID 와 버전은 같은 묶음에서만 고른다: GUARDRAIL_ID 가 있으면 GUARDRAIL_ID + GUARDRAIL_VERSION,
# 비어 있으면 예전 이름 BEDROCK_GUARDRAIL_ID + BEDROCK_GUARDRAIL_VERSION. 다른 묶음의 버전으로 채우지 않는다.
# 버전은 배포된 Guardrail 에 실제로 있는 버전 번호를 적는다(기본값 없음, DRAFT 로 대신하지 않음).
# 실제 모드(BEDROCK_MOCK=0)에서 ID·버전이 없거나 호출이 실패하면(SSO 만료 등) 검사 실패로 그 질문을 끝낸다.
# 가짜 모드는 AWS 없이 코드 검사만 한다.
GUARDRAIL_ID=
GUARDRAIL_VERSION=
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# 1 이면 상담 에이전트의 답에도 Guardrails 를 적용한다(기본 0). 화면 상담은 답 검사를 하지 않는다.
GUARDRAIL_OUTPUT=0
# 1(기본)이면 Guardrails 차단 주제로도 막는다. 0 이면 차단 주제는 기록만 하고 프롬프트 공격·혐오·모욕 필터만 막는다.
# 주제 정의 수정본 버전(11/19 팀 Guardrail 의 버전 2)은 1, 처음 정의 버전(버전 1)은 0 으로 둔다
# (버전 1 주제 정의는 "비전공자인데…" 같은 질문을 막는 오탐이 있었다).
GUARDRAIL_TOPIC_BLOCK=1

# 학습 상담 비교 실험 (backend/experiments.py, 2026-11-19 회의). 셋 다 비우면 실험이 꺼지고 상담은 전과 같다.
# EXPERIMENT_MODELS: 메시지마다 무작위로 고를 모델 ID 를 쉼표로 적는다(실제 모드에서만). 단가는 data/pricing.json 에 있어야 비용이 계산된다.
EXPERIMENT_MODELS=
# AB_STRUCTURES: A/B 로 비교할 추천 구조 이름을 쉼표로 적는다. 등록된 이름(single, reviewed) 2개 이상일 때만 켜진다.
AB_STRUCTURES=
# 평가와 A/B 선택을 남기는 DynamoDB 테이블(파티션 키 session_id, 정렬 키 turn_id). 내용은 저장하지 않는다.
DYNAMODB_FEEDBACK_TABLE=

# 사용자 테스트 설문 주소(https). 적으면 사이드바에 '사용 후기 설문 참여하기' 버튼이 생긴다. 비우면 버튼이 없다.
SURVEY_URL=
